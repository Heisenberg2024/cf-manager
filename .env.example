# Required: encryption key for encrypting stored API tokens (any random string, at least 16 chars)
ENCRYPTION_KEY=your-random-encryption-key-here

# Optional: protect the management UI with an API secret (leave empty to disable auth)
API_SECRET=

# Optional: HTTP/SOCKS5 proxy for Cloudflare API requests
# Examples: http://127.0.0.1:7890  socks5://127.0.0.1:1080
PROXY_URL=

# Optional: exposed port on the host (default: 3000)
APP_PORT=3000

# Optional: comma-separated account IDs to protect in demo mode
# Protected accounts cannot be deleted or modified by visitors
# Example: DEMO_ACCOUNT_IDS=1,2,3
DEMO_ACCOUNT_IDS=

# Optional: file logs remain under the persistent data volume (stdout is always enabled)
# Leave empty to derive from DB_PATH; Docker explicitly sets /app/data/logs
LOG_DIR=
FILE_LOGGING=true
